# Copy to .env and fill in. NEVER commit .env.
# ---- App ----
ENVIRONMENT=local              # local | staging | production
DEMO_MODE=true                 # true => synthetic tenant, sandboxed tools, hard quotas
LOG_LEVEL=INFO

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revops
POSTGRES_USER=revops
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://revops:change-me-locally@localhost:5432/revops

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- LLM providers (least privilege: separate keys per environment) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-sonnet-5
FALLBACK_MODEL=gpt-5.3

# ---- Observability ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-revops-local
LANGSMITH_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---- Auth ----
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---- External tools (sandboxed in demo mode) ----
EMAIL_PROVIDER_API_KEY=
CALENDAR_PROVIDER_API_KEY=
RESEARCH_PROVIDER_API_KEY=
OUTBOUND_EMAIL_ALLOWLIST=demo@example.com
