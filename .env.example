# Copy to .env and fill in. NEVER commit .env.
# ---- App ----
ENVIRONMENT=local              # local | staging | production
DEMO_MODE=true                 # true => synthetic tenant, sandboxed tools, hard quotas
LOG_LEVEL=INFO

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revops
POSTGRES_USER=revops
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://revops:change-me-locally@localhost:5432/revops

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- LLM providers (least privilege: separate keys per environment) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KNOWLEDGE_EMBEDDING_PROVIDER=fake # fake | openai; openai is explicit and requires OPENAI_API_KEY
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSION=1536
LLM_GATEWAY_MODE=disabled       # disabled | live; live is explicit and validates the route
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic # use none to run with one provider
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_CALL_DEADLINE_SECONDS=90
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8

# ---- Observability ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-revops-local
LANGSMITH_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---- Auth ----
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# ---- External tools (sandboxed in demo mode) ----
EMAIL_PROVIDER_API_KEY=
CALENDAR_PROVIDER_API_KEY=
RESEARCH_PROVIDER_API_KEY=
OUTBOUND_EMAIL_ALLOWLIST=demo@example.com
